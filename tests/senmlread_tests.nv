// senmlread_tests.nv — reading a SenML pack from CBOR.
//
// The first vector is the RFC's own: the 195 bytes that RFC 8428 section 6
// dumps for the voltage and current example.  The others are worked out by
// hand.  A CBOR head is the major type in the top three bits and the
// argument below: 0x81 an array of one, 0xA2 a map of two, 0x61 a text string
// of one byte, 0x21 the negative integer -2, 0x20 -1, 0xC4 the tag 4 that
// qualifies a decimal fraction, 0xF9 a half float, 0xFA a single, 0xFB a
// double, 0xF4 and 0xF5 false and true.

use std.test
use senmlpack
use senmlread

// A buffer from a list of byte values.
fn buf_of(xs: [Int]) -> senmlpack.SenmlBuf
    var b: senmlpack.SenmlBuf = Vec.new()
    for x in xs
        let _ = b.push(x as u8)
    b

// The bytes of a buffer as a list.
fn bytes_of(var out: senmlpack.SenmlBuf) -> [Int]
    var xs: [Int] = []
    for i in 0..out.len()
        xs = list.push(xs, out[i] as Int)
    xs

// What reading a list of bytes answers.
fn code_of(xs: [Int]) -> Int
    var b = buf_of(xs)
    var p = senmlpack.pack()
    senmlread.from_cbor(var b, var p)

// The value of record 0 after reading `[{0: "t", 2: <value bytes>}]`.
fn value_of(vbytes: [Int]) -> Float
    var b = buf_of(list.concat([0x81, 0xA2, 0x00, 0x61, 0x74, 0x02], vbytes))
    var p = senmlpack.pack()
    let code = senmlread.from_cbor(var b, var p)
    if code != 0
        return 0.0 - 1000000.0 - code as Float
    senmlpack.rec_value(p, 0)

// The code that reading `[{0: "t", 2: <value bytes>}]` answers.
fn value_code(vbytes: [Int]) -> Int
    code_of(list.concat([0x81, 0xA2, 0x00, 0x61, 0x74, 0x02], vbytes))

// The CBOR of RFC 8428 section 6, as the RFC dumps it.
fn rfc_dump() -> [Int]
    [0x87, 0xa7, 0x21, 0x78, 0x1b, 0x75, 0x72, 0x6e, 0x3a, 0x64, 0x65, 0x76, 0x3a, 0x6f, 0x77, 0x3a,
     0x31, 0x30, 0x65, 0x32, 0x30, 0x37, 0x33, 0x61, 0x30, 0x31, 0x30, 0x38, 0x30, 0x30, 0x36, 0x3a,
     0x22, 0xfb, 0x41, 0xd3, 0x03, 0xa1, 0x5b, 0x00, 0x10, 0x62, 0x23, 0x61, 0x41, 0x20, 0x05, 0x00,
     0x67, 0x76, 0x6f, 0x6c, 0x74, 0x61, 0x67, 0x65, 0x01, 0x61, 0x56, 0x02, 0xfb, 0x40, 0x5e, 0x06,
     0x66, 0x66, 0x66, 0x66, 0x66, 0xa3, 0x00, 0x67, 0x63, 0x75, 0x72, 0x72, 0x65, 0x6e, 0x74, 0x06,
     0x24, 0x02, 0xfb, 0x3f, 0xf3, 0x33, 0x33, 0x33, 0x33, 0x33, 0x33, 0xa3, 0x00, 0x67, 0x63, 0x75,
     0x72, 0x72, 0x65, 0x6e, 0x74, 0x06, 0x23, 0x02, 0xfb, 0x3f, 0xf4, 0xcc, 0xcc, 0xcc, 0xcc, 0xcc,
     0xcd, 0xa3, 0x00, 0x67, 0x63, 0x75, 0x72, 0x72, 0x65, 0x6e, 0x74, 0x06, 0x22, 0x02, 0xfb, 0x3f,
     0xf6, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0xa3, 0x00, 0x67, 0x63, 0x75, 0x72, 0x72, 0x65, 0x6e,
     0x74, 0x06, 0x21, 0x02, 0xf9, 0x3e, 0x00, 0xa3, 0x00, 0x67, 0x63, 0x75, 0x72, 0x72, 0x65, 0x6e,
     0x74, 0x06, 0x20, 0x02, 0xfb, 0x3f, 0xf9, 0x99, 0x99, 0x99, 0x99, 0x99, 0x9a, 0xa3, 0x00, 0x67,
     0x63, 0x75, 0x72, 0x72, 0x65, 0x6e, 0x74, 0x06, 0x00, 0x02, 0xfb, 0x3f, 0xfb, 0x33, 0x33, 0x33,
     0x33, 0x33, 0x33]

@test
fn test_the_rfc_dump_is_read() [io]
    var b = buf_of(rfc_dump())
    var p = senmlpack.pack()
    test.assert_eq(senmlread.from_cbor(var b, var p), senmlread.SENML_READ_OK)
    test.assert_eq(senmlpack.count(p), 7)
    test.assert_eq(senmlpack.validate(p), senmlpack.SENML_OK)
    test.assert_eq(p.bver, 5)
    test.assert_eq(p.bn_len, 27)
    test.assert_eq(p.bt, 1276020076.001)
    test.assert_eq(senmlpack.rec_name_len(p, 0), 27 + 7)
    test.assert_eq(senmlpack.rec_name_byte(p, 0, 27), 0x76)
    test.assert_eq(senmlpack.rec_value(p, 0), 120.1)
    test.assert_eq(senmlpack.rec_unit_byte(p, 0, 0), 0x56)
    test.assert_eq(senmlpack.rec_unit_byte(p, 1, 0), 0x41)
    test.assert_eq(senmlpack.rec_time(p, 0), 1276020076.001)
    test.assert_eq(senmlpack.rec_time(p, 1), 1276020071.001)
    test.assert_eq(senmlpack.rec_value(p, 4), 1.5)
    test.assert_eq(senmlpack.rec_value(p, 6), 1.7)
    test.case("what was read writes back to the same bytes")
    var out: senmlpack.SenmlBuf = Vec.new()
    test.assert(senmlpack.to_cbor(var p, var out))
    test.assert_eq(bytes_of(var out), rfc_dump())

@test
fn test_every_label() [io]
    // [{-2: "d", -3: 10, -4: "u", -5: 1, -6: 2, -1: 10,
    //   0: "n", 1: "m", 2: 3, 3: "s", 4: true, 5: 4, 6: 5, 7: 6}]
    var b = buf_of([0x81, 0xAE, 0x21, 0x61, 0x64, 0x22, 0x0A, 0x23, 0x61, 0x75, 0x24, 0x01, 0x25,
                    0x02, 0x20, 0x0A, 0x00, 0x61, 0x6E, 0x01, 0x61, 0x6D, 0x02, 0x03, 0x03, 0x61,
                    0x73, 0x04, 0xF5, 0x05, 0x04, 0x06, 0x05, 0x07, 0x06])
    var p = senmlpack.pack()
    test.assert_eq(senmlread.from_cbor(var b, var p), senmlread.SENML_READ_OK)
    test.assert_eq(p.bt, 10.0)
    test.assert_eq(p.bv, 1.0)
    test.assert_eq(p.bs, 2.0)
    test.assert_eq(p.bver, 10)
    test.assert_eq(senmlpack.rec_value(p, 0), 4.0)
    test.assert_eq(senmlpack.rec_sum(p, 0), 6.0)
    test.assert_eq(senmlpack.rec_time(p, 0), 15.0)
    test.assert_eq(p.recs[0].ut, 6.0)
    test.assert_eq(p.recs[0].s_len, 1)
    test.assert(senmlpack.rec_has(p, 0, senmlpack.SENML_HAS_VB))
    test.assert(senmlpack.rec_has(p, 0, senmlpack.SENML_VB_TRUE))
    test.assert(senmlpack.rec_has(p, 0, senmlpack.SENML_HAS_VS))
    test.assert_eq(senmlpack.rec_unit_len(p, 0), 1)

@test
fn test_false_is_false() [io]
    var b = buf_of([0x81, 0xA2, 0x00, 0x61, 0x74, 0x04, 0xF4])
    var p = senmlpack.pack()
    test.assert_eq(senmlread.from_cbor(var b, var p), senmlread.SENML_READ_OK)
    test.assert(senmlpack.rec_has(p, 0, senmlpack.SENML_HAS_VB))
    test.assert(not senmlpack.rec_has(p, 0, senmlpack.SENML_VB_TRUE))

@test
fn test_the_forms_of_a_number() [io]
    test.case("integers: 23, 24, 256, -1, -25")
    test.assert_eq(value_of([0x17]), 23.0)
    test.assert_eq(value_of([0x18, 0x18]), 24.0)
    test.assert_eq(value_of([0x19, 0x01, 0x00]), 256.0)
    test.assert_eq(value_of([0x20]), -1.0)
    test.assert_eq(value_of([0x38, 0x18]), -25.0)
    test.case("a half: 1.5, -1, the smallest subnormal, a normal")
    test.assert_eq(value_of([0xF9, 0x3E, 0x00]), 1.5)
    test.assert_eq(value_of([0xF9, 0xBC, 0x00]), -1.0)
    test.assert_eq(value_of([0xF9, 0x00, 0x01]), 0.000000059604644775390625)
    test.assert_eq(value_of([0xF9, 0x04, 0x00]), 0.00006103515625)
    test.assert_eq(value_of([0xF9, 0x7B, 0xFF]), 65504.0)
    test.case("a single: 1.5, -2, the smallest subnormal, 100000.5")
    test.assert_eq(value_of([0xFA, 0x3F, 0xC0, 0x00, 0x00]), 1.5)
    test.assert_eq(value_of([0xFA, 0xC0, 0x00, 0x00, 0x00]), -2.0)
    test.assert_eq(value_of([0xFA, 0x47, 0xC3, 0x50, 0x40]), 100000.5)
    test.assert_eq(value_of([0xFA, 0x00, 0x00, 0x00, 0x01]), 1.4012984643248171e-45)
    test.case("a double")
    test.assert_eq(value_of([0xFB, 0x40, 0x5E, 0x06, 0x66, 0x66, 0x66, 0x66, 0x66]), 120.1)
    test.case("a decimal fraction: 231 x 10^-1, 5 x 10^2, -7 x 10^0")
    test.assert_eq(value_of([0xC4, 0x82, 0x20, 0x18, 0xE7]), 23.1)
    test.assert_eq(value_of([0xC4, 0x82, 0x02, 0x05]), 500.0)
    test.assert_eq(value_of([0xC4, 0x82, 0x00, 0x26]), -7.0)

@test
fn test_numbers_that_are_refused() [io]
    test.case("infinity and NaN, as a half and as a single")
    test.assert_eq(value_code([0xF9, 0x7C, 0x00]), senmlread.SENML_READ_RANGE)
    test.assert_eq(value_code([0xF9, 0x7E, 0x00]), senmlread.SENML_READ_RANGE)
    test.assert_eq(value_code([0xFA, 0x7F, 0x80, 0x00, 0x00]), senmlread.SENML_READ_RANGE)
    test.case("a decimal fraction with an exponent past 22, either way")
    test.assert_eq(value_code([0xC4, 0x82, 0x17, 0x01]), senmlread.SENML_READ_RANGE)
    test.assert_eq(value_code([0xC4, 0x82, 0x36, 0x01]), senmlread.SENML_READ_RANGE)
    test.assert_eq(value_code([0xC4, 0x82, 0x16, 0x01]), senmlread.SENML_READ_OK)
    test.case("a decimal fraction that is not an array of two")
    test.assert_eq(value_code([0xC4, 0x81, 0x01]), senmlread.SENML_READ_TYPE)
    test.assert_eq(value_code([0xC4, 0x01]), senmlread.SENML_READ_TYPE)
    test.assert_eq(value_code([0xC4, 0x82, 0x61, 0x61, 0x01]), senmlread.SENML_READ_TYPE)
    test.case("a tag that is not 4, a string, a boolean")
    test.assert_eq(value_code([0xC5, 0x82, 0x01, 0x01]), senmlread.SENML_READ_TYPE)
    test.assert_eq(value_code([0x61, 0x61]), senmlread.SENML_READ_TYPE)
    test.assert_eq(value_code([0xF5]), senmlread.SENML_READ_TYPE)
    test.case("an integer that does not fit 63 bits")
    test.assert_eq(value_code([0x1B, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]),
                   senmlread.SENML_READ_TYPE)
    test.assert_eq(value_code([0x3B, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]),
                   senmlread.SENML_READ_TYPE)

@test
fn test_a_pack_that_is_not_one() [io]
    test.case("nothing at all")
    test.assert_eq(code_of([]), senmlread.SENML_READ_TRUNCATED)
    test.case("the top level is a map, or a record is not")
    test.assert_eq(code_of([0xA0]), senmlread.SENML_READ_MALFORMED)
    test.assert_eq(code_of([0x81, 0x01]), senmlread.SENML_READ_MALFORMED)
    test.case("a key that is a boolean")
    test.assert_eq(code_of([0x81, 0xA1, 0xF5, 0x01]), senmlread.SENML_READ_MALFORMED)
    test.case("a reserved additional information")
    test.assert_eq(code_of([0x81, 0xA1, 0x1C, 0x01]), senmlread.SENML_READ_MALFORMED)
    test.case("bytes after the array")
    test.assert_eq(code_of([0x80, 0x00]), senmlread.SENML_READ_TRAILING)
    test.case("an empty array is a pack with no records")
    test.assert_eq(code_of([0x80]), senmlread.SENML_READ_OK)
    test.case("a map cut short")
    test.assert_eq(code_of([0x81, 0xA1, 0x00]), senmlread.SENML_READ_TRUNCATED)
    test.assert_eq(code_of([0x81, 0xA1]), senmlread.SENML_READ_TRUNCATED)
    test.assert_eq(code_of([0x81]), senmlread.SENML_READ_TRUNCATED)
    test.assert_eq(code_of([0x82, 0xA0]), senmlread.SENML_READ_TRUNCATED)
    test.assert_eq(code_of([0x81, 0xA1, 0x18]), senmlread.SENML_READ_TRUNCATED)
    test.assert_eq(code_of([0x81, 0xA1, 0x00, 0x1A, 0x00, 0x01]), senmlread.SENML_READ_TRUNCATED)

@test
fn test_indefinite_arrays_and_maps() [io]
    // 9F A2 00 61 74 02 17 FF FF: an indefinite array of an indefinite-
    // length map written definite, then the break; and the map indefinite.
    test.assert_eq(code_of([0x9F, 0xA2, 0x00, 0x61, 0x74, 0x02, 0x17, 0xFF]), senmlread.SENML_READ_OK)
    test.assert_eq(code_of([0x81, 0xBF, 0x00, 0x61, 0x74, 0x02, 0x17, 0xFF]), senmlread.SENML_READ_OK)
    test.assert_eq(code_of([0x9F, 0xBF, 0x00, 0x61, 0x74, 0x02, 0x17, 0xFF, 0xFF]),
                   senmlread.SENML_READ_OK)
    test.case("an indefinite array with no break")
    test.assert_eq(code_of([0x9F, 0xA2, 0x00, 0x61, 0x74, 0x02, 0x17]), senmlread.SENML_READ_TRUNCATED)
    test.case("an indefinite map with no break")
    test.assert_eq(code_of([0x81, 0xBF, 0x00, 0x61, 0x74, 0x02, 0x17]), senmlread.SENML_READ_TRUNCATED)

@test
fn test_fields_that_are_skipped_or_refused() [io]
    test.case("an integer label this package does not know is skipped with its value")
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0x82, 0x01, 0xA1, 0x01, 0x02, 0x02, 0x17]),
                   senmlread.SENML_READ_OK)
    test.case("a text label is skipped with its value, whatever it is")
    // {"x": [1, {2: 3}], 2: 5}
    var b = buf_of([0x81, 0xA2, 0x61, 0x78, 0x82, 0x01, 0xA1, 0x02, 0x03, 0x02, 0x05])
    var p = senmlpack.pack()
    test.assert_eq(senmlread.from_cbor(var b, var p), senmlread.SENML_READ_OK)
    test.assert_eq(senmlpack.rec_value(p, 0), 5.0)
    test.case("a text label ending in an underscore must be understood")
    test.assert_eq(code_of([0x81, 0xA1, 0x62, 0x78, 0x5F, 0x01]), senmlread.SENML_READ_UNSUPPORTED)
    test.case("a text label that runs past the end")
    test.assert_eq(code_of([0x81, 0xA1, 0x65, 0x78]), senmlread.SENML_READ_MALFORMED)
    test.case("the data value is not carried")
    test.assert_eq(code_of([0x81, 0xA1, 0x08, 0x41, 0x01]), senmlread.SENML_READ_UNSUPPORTED)
    test.case("a base field after the first record")
    test.assert_eq(code_of([0x82, 0xA1, 0x00, 0x61, 0x61, 0xA2, 0x00, 0x61, 0x62, 0x22, 0x0A]),
                   senmlread.SENML_READ_LATE_BASE)

@test
fn test_skipping_every_kind_of_value() [io]
    // Each is the value of an unknown label 9, followed by a known field,
    // so that a skip that stops short or runs on shows in the result.
    test.case("a byte string, a text string, a negative integer, a simple value")
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0x42, 0x01, 0x02, 0x02, 0x01]), senmlread.SENML_READ_OK)
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0x62, 0x61, 0x62, 0x02, 0x01]), senmlread.SENML_READ_OK)
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0x38, 0x20, 0x02, 0x01]), senmlread.SENML_READ_OK)
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0xF6, 0x02, 0x01]), senmlread.SENML_READ_OK)
    test.case("a tagged value, a map, an array")
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0xC1, 0x1A, 0x00, 0x00, 0x00, 0x01, 0x02, 0x01]),
                   senmlread.SENML_READ_OK)
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0xA2, 0x01, 0x02, 0x03, 0x04, 0x02, 0x01]),
                   senmlread.SENML_READ_OK)
    test.case("indefinite strings, arrays and maps")
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0x5F, 0x41, 0x01, 0x41, 0x02, 0xFF, 0x02, 0x01]),
                   senmlread.SENML_READ_OK)
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0x7F, 0x61, 0x61, 0xFF, 0x02, 0x01]),
                   senmlread.SENML_READ_OK)
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0x9F, 0x01, 0x02, 0xFF, 0x02, 0x01]),
                   senmlread.SENML_READ_OK)
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0xBF, 0x01, 0x02, 0xFF, 0x02, 0x01]),
                   senmlread.SENML_READ_OK)
    test.case("a string that runs past the end, and a value that is cut short")
    test.assert_eq(code_of([0x81, 0xA2, 0x09, 0x45, 0x01, 0x02, 0x01]), senmlread.SENML_READ_TRUNCATED)
    test.assert_eq(code_of([0x81, 0xA1, 0x09, 0x82, 0x01]), senmlread.SENML_READ_TRUNCATED)
    test.assert_eq(code_of([0x81, 0xA1, 0x09]), senmlread.SENML_READ_TRUNCATED)

@test
fn test_strings() [io]
    test.case("an indefinite text string is not carried")
    test.assert_eq(code_of([0x81, 0xA1, 0x00, 0x7F, 0x61, 0x61, 0xFF]), senmlread.SENML_READ_UNSUPPORTED)
    test.case("a text string cut short")
    test.assert_eq(code_of([0x81, 0xA1, 0x00, 0x65, 0x61]), senmlread.SENML_READ_TRUNCATED)
    test.case("a name that is not text")
    test.assert_eq(code_of([0x81, 0xA1, 0x00, 0x01]), senmlread.SENML_READ_TYPE)
    test.case("a boolean that is not one")
    test.assert_eq(code_of([0x81, 0xA1, 0x04, 0x01]), senmlread.SENML_READ_TYPE)
    test.assert_eq(code_of([0x81, 0xA1, 0x04, 0xF6]), senmlread.SENML_READ_TYPE)
    test.case("a version that is not an integer")
    test.assert_eq(code_of([0x81, 0xA1, 0x20, 0x61, 0x61]), senmlread.SENML_READ_TYPE)

@test
fn test_what_does_not_fit_the_pack() [io]
    test.case("nine records")
    var nine: [Int] = [0x89]
    for _k in 0..9
        nine = list.concat(nine, [0xA1, 0x00, 0x61, 0x61])
    test.assert_eq(code_of(nine), senmlread.SENML_READ_TOO_MANY)
    test.case("eight records fit")
    var eight: [Int] = [0x88]
    for _k in 0..8
        eight = list.concat(eight, [0xA1, 0x00, 0x61, 0x61])
    test.assert_eq(code_of(eight), senmlread.SENML_READ_OK)
    test.case("strings past 256 bytes")
    var big: [Int] = [0x81, 0xA1, 0x00, 0x79, 0x01, 0x2C]
    for _k in 0..300
        big = list.push(big, 0x61)
    test.assert_eq(code_of(big), senmlread.SENML_READ_TOO_MANY)

@test
fn test_a_value_missing_and_a_value_too_deep() [io]
    test.case("a number with nothing after its label")
    test.assert_eq(code_of([0x81, 0xA1, 0x02]), senmlread.SENML_READ_TRUNCATED)
    test.case("an unknown label whose value is nested 15 deep is skipped, 16 is refused")
    var ok_depth: [Int] = [0x81, 0xA1, 0x09]
    for _k in 0..15
        ok_depth = list.push(ok_depth, 0x81)
    ok_depth = list.push(ok_depth, 0x01)
    test.assert_eq(code_of(ok_depth), senmlread.SENML_READ_OK)
    var too_deep: [Int] = [0x81, 0xA1, 0x09]
    for _k in 0..16
        too_deep = list.push(too_deep, 0x81)
    too_deep = list.push(too_deep, 0x01)
    test.assert_eq(code_of(too_deep), senmlread.SENML_READ_MALFORMED)
